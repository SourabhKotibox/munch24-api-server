        {
          "name": "GET /api/app/upcoming?tab=remind_me (My Reminders Tab)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/app/upcoming?tab=remind_me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "app",
                "upcoming"
              ],
              "query": [
                {
                  "key": "tab",
                  "value": "remind_me"
                }
              ]
            },
            "description": "Returns upcoming titles user has clicked Remind Me on. Requires JWT token."
          }
        },
        {
          "name": "POST /api/app/upcoming/:id/remind (Toggle Remind Me)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/app/upcoming/{{upcoming_id}}/remind",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "app",
                "upcoming",
                "{{upcoming_id}}",
                "remind"
              ]
            },
            "description": "Toggles user reminder on/off. Returns updated isReminded and reminderCount."
          }
        },
        {
          "name": "GET /api/app/upcoming/reminders (User Reminded List)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/app/upcoming/reminders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "app",
                "upcoming",
                "reminders"
              ]
            }
          }
        }
      ]
