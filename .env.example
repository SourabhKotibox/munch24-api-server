PORT=3000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000

# Deep Linking / Share settings
APP_PACKAGE_NAME=com.xoto.app
APP_SCHEME=xoto
APP_STORE_ID=123456789

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/triple-mindes

# Redis Connection
REDIS_URI=redis://localhost:6379

# AWS S3 Configuration
AWS_S3_ACCESS_KEY_ID=your-access-key-id
AWS_S3_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET_NAME=tripleminds-ott-admin
AWS_S3_REGION=us-east-1

# DigitalOcean Spaces (optional fallback if not stored in Settings)
DO_ACCESS_KEY=
DO_SECRET_KEY=
DO_REGION=nyc3
DO_BUCKET=
DO_CDN_URL=

# Direct-to-Spaces uploads (admin browser → Spaces, not through the API)
UPLOAD_PART_SIZE_MB=16
UPLOAD_PART_CONCURRENCY=4
DIRECT_UPLOAD_THRESHOLD_MB=8
MULTIPART_ABANDONED_HOURS=24

# Admin Panel Seed Credentials (used by: npm run seed-admin)
ADMIN_EMAIL=admin@tripleminds.co
ADMIN_PASSWORD=AdminPassword123!
