{
  "info": {
    "name": "Munch24 - Updated App APIs (Upcoming & Home)",
    "description": "Postman collection for Upcoming content, Remind Me, Home Banners with trailer playback, and Home layout sections.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "YOUR_JWT_TOKEN",
      "type": "string"
    },
    {
      "key": "movie_id",
      "value": "670c1234abcd5678ef000101",
      "type": "string"
    },
    {
      "key": "series_id",
      "value": "670c1234abcd5678ef000102",
      "type": "string"
    },
    {
      "key": "upcoming_id",
      "value": "670c1234abcd5678ef000103",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Upcoming Content & Banners",
      "item": [
        {
          "name": "GET /api/app/upcoming (All Upcoming + Banners)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/app/upcoming?tab=all&page=1&limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "app",
                "upcoming"
              ],
              "query": [
                {
                  "key": "tab",
                  "value": "all",
                  "description": "all | movie | series | drama | remind_me"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Fetches top upcoming banners with playable trailers and paginated upcoming content titles."
          }
        },
        {
          "name": "GET /api/app/upcoming?tab=movie (Upcoming Movies)",
