    {
      "name": "4. Profile, Contact & Legal Pages",
      "item": [
        {
          "name": "GET /api/app/profile (or /api/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/app/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "app",
                "profile"
              ]
            },
            "description": "Returns user profile, contactDetails (support phone, inquiry/support email, whatsapp, address, store links), socialLinks (with icon, name, platform, url), socialUrls, legalPages (About Us, Privacy Policy, Terms), full published pages, and appSettings."
          }
        },
