    {
      "name": "3. Content Detail & Stream Qualities",
      "item": [
        {
          "name": "GET /api/app/movies/:id (Movie Detail + Qualities + Trailer)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/app/movies/{{movie_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "app",
                "movies",
                "{{movie_id}}"
              ]
            },
            "description": "Fetches complete movie details with videoQualities, videoSettings (Auto, 1080p, 720p, 480p), trailerUrl, and trailerType."
