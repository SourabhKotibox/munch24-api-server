              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "app",
                "contact"
              ]
            },
            "description": "Returns contactDetails (phone, supportPhone, email, supportEmail, inquiryEmail, whatsappNumber, whatsappUrl, address, websiteUrl), socialLinks array for rendering clickable social media icons, and socialUrls map."
          }
        },
        {
          "name": "GET /api/app/pages (All Legal & CMS Pages)",
          "request": {
